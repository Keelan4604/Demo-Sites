{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beer-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "beer-tracker", "database_id": "c79fe986-379f-4f84-b184-7ce79a7e43cd" }
  ],
  "routes": [
    { "pattern": "beer.keelanodoherty.org", "custom_domain": true }
  ]
}
